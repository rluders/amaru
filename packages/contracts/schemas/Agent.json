{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amaru.invalid/contracts/v1/schemas/Agent.json",
  "title": "Agent",
  "description": "A reusable participant definition, stored at `.amaru/agents/<id>.json`. `skills` are Skill names, each resolved to a trusted Skill when a run starts; `requestedCapabilities` is a declaration, never enforced.",
  "type": "object",
  "required": [
    "id",
    "name",
    "instructions",
    "requestedCapabilities",
    "providerPreference",
    "status",
    "createdAt",
    "updatedAt",
    "hash",
    "revision"
  ],
  "additionalProperties": false,
  "properties": {
    "worktreeWrite": {
      "type": "boolean"
    },
    "worktreeCommands": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._+-]{0,31}( -{0,2}[A-Za-z0-9][A-Za-z0-9._+=/:-]{0,63}){0,3}$"
      },
      "description": "Shell command prefixes run in an OS sandbox in the worktree. Needs worktreeWrite."
    },
    "id": {
      "$ref": "AgentId.json"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "role": {
      "type": "string",
      "maxLength": 120
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "requestedCapabilities": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "$ref": "CapabilityId.json"
      }
    },
    "providerPreference": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "ProviderId.json"
      }
    },
    "models": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "$ref": "ProviderId.json"
      },
      "additionalProperties": {
        "$ref": "AgentModel.json"
      },
      "description": "Model per agent provider id; wins over `model` for that provider."
    },
    "model": {
      "$ref": "AgentModel.json"
    },
    "status": {
      "$ref": "AgentStatus.json"
    },
    "createdAt": {
      "$ref": "Timestamp.json"
    },
    "updatedAt": {
      "$ref": "Timestamp.json"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Revision of this definition; starts at 1 and grows by one per recorded change. Deleting and recreating continue the same sequence."
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the canonical definition without timestamps. Equal hashes mean equal definitions."
    }
  }
}
