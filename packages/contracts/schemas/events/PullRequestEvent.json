{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amaru.invalid/contracts/v1/schemas/events/PullRequestEvent.json",
  "title": "PullRequestEvent",
  "description": "A normalized pull request event from the Git host. Never the raw payload.",
  "allOf": [
    {
      "$ref": "EventBase.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "pr.opened",
            "pr.closed",
            "pr.merged",
            "pr.reviewed",
            "pr.commented",
            "pr.updated"
          ]
        },
        "data": {
          "type": "object",
          "required": [
            "repo",
            "number",
            "action",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "repo": {
              "type": "string"
            },
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "action": {
              "type": "string",
              "minLength": 1
            },
            "branch": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "merged": {
              "type": "boolean"
            },
            "reviewState": {
              "type": "string"
            },
            "source": {
              "enum": [
                "webhook",
                "resync",
                "reconcile"
              ]
            },
            "deliveryId": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
