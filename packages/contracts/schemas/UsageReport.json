{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amaru.invalid/contracts/v1/schemas/UsageReport.json",
  "title": "UsageReport",
  "description": "The measurements of one usage record, without Platform identity. This is what a Provider or Worker reports (ADR-0033). Every number is a measurement with a source; `value` is absent when the source is `unknown`.",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "inputTokens": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "$ref": "UsageSource.json"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "unknown"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "enum": [
                  "reported",
                  "estimated"
                ]
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    "outputTokens": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "$ref": "UsageSource.json"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "unknown"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "enum": [
                  "reported",
                  "estimated"
                ]
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    "cacheReadTokens": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "$ref": "UsageSource.json"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "unknown"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "enum": [
                  "reported",
                  "estimated"
                ]
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    "cacheWriteTokens": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "$ref": "UsageSource.json"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "unknown"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "enum": [
                  "reported",
                  "estimated"
                ]
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    "credits": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "$ref": "UsageSource.json"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "unknown"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "enum": [
                  "reported",
                  "estimated"
                ]
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    "wallDurationMs": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "$ref": "UsageSource.json"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "unknown"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "enum": [
                  "reported",
                  "estimated"
                ]
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    "cost": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "source": {
          "$ref": "UsageSource.json"
        },
        "priceTableVersion": {
          "type": "string",
          "minLength": 1,
          "description": "Required when source is estimated."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "enum": [
                  "reported",
                  "estimated"
                ]
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "amount",
              "currency"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "unknown"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "amount"
                  ]
                },
                {
                  "required": [
                    "currency"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "estimated"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "priceTableVersion"
            ]
          }
        }
      ]
    },
    "environmentId": {
      "type": "string",
      "minLength": 1
    },
    "costClass": {
      "type": "string",
      "minLength": 1
    }
  }
}
