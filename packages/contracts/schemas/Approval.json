{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amaru.invalid/contracts/v1/schemas/Approval.json",
  "title": "Approval",
  "description": "A human decision bound to specific Evidence (ADR-0036). `approved` and `rejected` are terminal and immutable. `occurrence` and the use-time digest check are decided by ADR-0048 (accepted 2026-10-26, Q56).",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "projectId",
    "state",
    "gate",
    "requester",
    "requirement",
    "evidence",
    "requestedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "Ulid.json"
    },
    "organizationId": {
      "$ref": "Ulid.json"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "requested",
        "approved",
        "rejected",
        "expired",
        "voided"
      ]
    },
    "gate": {
      "$ref": "ApprovalGate.json"
    },
    "occurrence": {
      "$ref": "ApprovalOccurrence.json"
    },
    "requester": {
      "$ref": "Principal.json"
    },
    "requirement": {
      "$ref": "ApprovalRequirement.json"
    },
    "evidence": {
      "type": "object",
      "required": [
        "digest",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "Digest.json"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "EvidenceItem.json"
          }
        }
      }
    },
    "decision": {
      "$ref": "ApprovalDecisionRecord.json"
    },
    "requestedAt": {
      "$ref": "Timestamp.json"
    },
    "replaces": {
      "oneOf": [
        {
          "$ref": "Ulid.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "voidedBy": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "approved",
              "rejected"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "decision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "requested",
              "expired",
              "voided"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "not": {
          "required": [
            "decision"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "approved"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "outcome": {
                "const": "approved"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "rejected"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "outcome": {
                "const": "rejected"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "voided"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "voidedBy"
        ]
      }
    }
  ]
}
