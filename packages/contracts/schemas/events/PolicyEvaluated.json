{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amaru.invalid/contracts/v1/schemas/events/PolicyEvaluated.json",
  "title": "PolicyEvaluated",
  "description": "Every Policy evaluation is recorded (ADR-0037): the input hash, the decision and the reason codes.",
  "allOf": [
    {
      "$ref": "EventBase.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "policy.evaluated"
        },
        "data": {
          "type": "object",
          "required": [
            "requestId",
            "decision",
            "inputHash",
            "reasonCodes"
          ],
          "additionalProperties": false,
          "properties": {
            "requestId": {
              "$ref": "../Ulid.json"
            },
            "decision": {
              "enum": [
                "allow",
                "require_approval",
                "deny"
              ]
            },
            "inputHash": {
              "$ref": "../Digest.json"
            },
            "reasonCodes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
