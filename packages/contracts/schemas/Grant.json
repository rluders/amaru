{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amaru.invalid/contracts/v1/schemas/Grant.json",
  "title": "Grant",
  "description": "A standing authorization created by a human Owner or Admin (ADR-0037, ADR-0038, baseline rule 12). Authorizes many occurrences within its match; an Approval authorizes one.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "scope",
    "subject",
    "capabilities",
    "resource",
    "grantedBy",
    "createdAt",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "Ulid.json"
    },
    "scope": {
      "type": "object",
      "required": [
        "level"
      ],
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "organization",
            "project"
          ]
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subject": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "workflow",
            "plugin_component"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resource": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "match": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "definitionHash": {
      "$ref": "Digest.json"
    },
    "grantedBy": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "$ref": "Timestamp.json"
    },
    "expiresAt": {
      "oneOf": [
        {
          "$ref": "Timestamp.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "active",
        "lapsed",
        "revoked",
        "expired"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "level": {
                "const": "project"
              }
            },
            "required": [
              "level"
            ]
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "scope": {
            "required": [
              "projectId"
            ]
          }
        }
      }
    }
  ]
}
