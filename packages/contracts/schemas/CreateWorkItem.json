{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amaru.invalid/contracts/v1/schemas/CreateWorkItem.json",
  "title": "CreateWorkItem",
  "type": "object",
  "required": [
    "packageId",
    "title"
  ],
  "additionalProperties": false,
  "properties": {
    "dependsOn": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "$ref": "WorkItemId.json"
      }
    },
    "workflowId": {
      "anyOf": [
        {
          "$ref": "WorkflowId.json"
        },
        {
          "const": ""
        }
      ]
    },
    "packageId": {
      "$ref": "WorkPackageId.json"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "intent": {
      "type": "string",
      "maxLength": 8000
    },
    "owner": {
      "$ref": "WorkOwner.json"
    }
  }
}
