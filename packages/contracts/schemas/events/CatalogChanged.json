{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amaru.invalid/contracts/v1/schemas/events/CatalogChanged.json",
  "title": "CatalogChanged",
  "description": "Agent or Team files were edited, added or removed outside the Platform; `ids` are the ones that changed. Clients refetch the list.",
  "allOf": [
    {
      "$ref": "EventBase.json"
    },
    {
      "type": "object",
      "not": {
        "required": [
          "executionId"
        ]
      },
      "properties": {
        "type": {
          "enum": [
            "agent.changed",
            "team.changed"
          ]
        },
        "data": {
          "type": "object",
          "required": [
            "ids"
          ],
          "additionalProperties": false,
          "properties": {
            "ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
