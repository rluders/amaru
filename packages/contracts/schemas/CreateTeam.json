{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amaru.invalid/contracts/v1/schemas/CreateTeam.json",
  "title": "CreateTeam",
  "type": "object",
  "required": [
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "AgentId.json"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "members": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "TeamMember.json"
      }
    },
    "separationOfDuties": {
      "type": "boolean"
    }
  }
}
