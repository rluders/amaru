{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amaru.invalid/contracts/v1/schemas/ProviderStatus.json",
  "title": "ProviderStatus",
  "type": "object",
  "required": [
    "available"
  ],
  "additionalProperties": false,
  "properties": {
    "available": {
      "type": "boolean"
    },
    "version": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "description": "Why unavailable, e.g. \"executable not found\"."
    }
  }
}
