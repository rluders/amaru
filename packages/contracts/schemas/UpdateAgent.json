{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amaru.invalid/contracts/v1/schemas/UpdateAgent.json",
  "title": "UpdateAgent",
  "description": "Fields present replace the stored value; lists replace the whole list. The id is immutable (not accepted). `expectedRevision` is required.",
  "type": "object",
  "minProperties": 2,
  "additionalProperties": false,
  "properties": {
    "worktreeWrite": {
      "type": "boolean"
    },
    "worktreeCommands": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._+-]{0,31}( -{0,2}[A-Za-z0-9][A-Za-z0-9._+=/:-]{0,63}){0,3}$"
      },
      "description": "Shell command prefixes run in an OS sandbox in the worktree. Needs worktreeWrite."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "role": {
      "type": "string",
      "maxLength": 120
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "requestedCapabilities": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "$ref": "CapabilityId.json"
      }
    },
    "providerPreference": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "ProviderId.json"
      }
    },
    "models": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "$ref": "ProviderId.json"
      },
      "additionalProperties": {
        "$ref": "AgentModel.json"
      },
      "description": "Model per agent provider id; wins over `model` for that provider."
    },
    "model": {
      "type": "string",
      "maxLength": 80,
      "description": "Empty string clears the model."
    },
    "status": {
      "$ref": "AgentStatus.json"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 1,
      "description": "The revision the caller read. If the Agent has moved on, the update is rejected with `conflict` (lost-update guard)."
    }
  },
  "required": [
    "expectedRevision"
  ]
}
