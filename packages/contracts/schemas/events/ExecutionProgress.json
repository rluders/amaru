{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amaru.invalid/contracts/v1/schemas/events/ExecutionProgress.json",
  "title": "ExecutionProgress",
  "allOf": [
    {
      "$ref": "EventBase.json"
    },
    {
      "type": "object",
      "required": [
        "executionId"
      ],
      "properties": {
        "type": {
          "const": "execution.progress"
        },
        "data": {
          "type": "object",
          "required": [
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "message": {
              "type": "string",
              "minLength": 1
            },
            "percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      }
    }
  ]
}
