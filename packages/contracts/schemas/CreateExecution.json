{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amaru.invalid/contracts/v1/schemas/CreateExecution.json",
  "title": "CreateExecution",
  "type": "object",
  "required": [
    "capability",
    "input"
  ],
  "additionalProperties": false,
  "properties": {
    "capability": {
      "$ref": "CapabilityId.json"
    },
    "providerId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "description": "Artifact id (project-relative note path) for asset.generate."
        }
      },
      "oneOf": [
        {
          "required": [
            "prompt"
          ],
          "not": {
            "required": [
              "artifactId"
            ]
          }
        },
        {
          "required": [
            "artifactId"
          ],
          "not": {
            "required": [
              "prompt"
            ]
          }
        }
      ]
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "workItemId": {
      "$ref": "WorkItemId.json"
    }
  }
}
