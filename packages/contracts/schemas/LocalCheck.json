{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amaru.invalid/contracts/v1/schemas/LocalCheck.json",
  "title": "LocalCheck",
  "type": "object",
  "required": [
    "name",
    "command"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 1024
      },
      "description": "argv. command[0] is a bare executable name found on the Platform's PATH; no shell, no expansion."
    },
    "dir": {
      "type": "string",
      "maxLength": 500,
      "description": "Worktree-relative directory; default the worktree root."
    },
    "timeoutSec": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600,
      "description": "0 = 600."
    }
  }
}
