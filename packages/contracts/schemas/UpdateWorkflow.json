{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amaru.invalid/contracts/v1/schemas/UpdateWorkflow.json",
  "title": "UpdateWorkflow",
  "description": "Fields present replace the stored value; `steps`/`variables` replace the whole list.",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "status": {
      "$ref": "WorkflowStatus.json"
    },
    "type": {
      "$ref": "WorkflowType.json"
    },
    "steps": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "WorkflowStep.json"
      }
    },
    "variables": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "WorkflowVariable.json"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "WorkflowEdge.json"
      }
    },
    "layout": {
      "$ref": "WorkflowLayout.json"
    }
  }
}
