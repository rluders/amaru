{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amaru.invalid/contracts/v1/schemas/IssueRef.json",
  "title": "IssueRef",
  "description": "The issue a Work Item was imported from (WorkItem.external); (repo, number) identifies it.",
  "type": "object",
  "required": [
    "provider",
    "repo",
    "number",
    "updatedAt",
    "state"
  ],
  "additionalProperties": false,
  "properties": {
    "provider": {
      "const": "github"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "url": {
      "type": "string",
      "maxLength": 1000
    },
    "updatedAt": {
      "$ref": "Timestamp.json"
    },
    "state": {
      "enum": [
        "open",
        "closed"
      ]
    },
    "labels": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string"
      }
    },
    "blockedBy": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "IssueDep.json"
      },
      "description": "GitHub issue dependencies: the issues this one is blocked by."
    }
  }
}
